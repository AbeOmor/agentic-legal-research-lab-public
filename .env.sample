# Application-side Azure OpenAI configuration for Agent Framework and Mem0.
# Notebook 1 and database-side retrieval use HorizonDB AI Model Management aliases.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=your_chat_deployment
AZURE_EMBED_DEPLOYMENT=your_embedding_deployment
AZURE_API_VERSION=your_supported_api_version

# Azure HorizonDB connection
AZURE_PG_HOST=your-cluster-id.australiaeast.horizondb.azure.com
AZURE_PG_NAME=postgres
AZURE_PG_USER=your_admin_user
AZURE_PG_PASSWORD=your_database_password
AZURE_PG_PORT=5432
AZURE_PG_SSLMODE=require
