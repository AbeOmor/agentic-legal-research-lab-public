# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=your_openai_endpoint_here
AZURE_OPENAI_KEY=your_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small
AZURE_API_VERSION="2025-03-01-preview"

# Database Configuration
AZURE_PG_HOST=your_postgres_host_here
AZURE_PG_NAME=postgres
AZURE_PG_USER="AzureUser"
AZURE_PG_PASSWORD="Password@1234"
AZURE_PG_PORT=5432
AZURE_PG_SSLMODE=require